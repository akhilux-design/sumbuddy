{
  "name": "xpense-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var ENVIRONMENT:development",
    "db:migrate:local": "wrangler d1 migrations apply xpense --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/check-prod-config.mjs && node scripts/check-remote-migrations.mjs && wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
