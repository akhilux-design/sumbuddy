<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: plain HTTP is allowed to 10.0.2.2, which is how the emulator reaches the Mac running the local
    server (`npm run dev` in server/). Every other host stays HTTPS only. Release builds use src/main's file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
