<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All app styling is done in Compose (see ui/theme). The window background is the canvas
         colour per theme (colors_window.xml, generated by design/tools/gen_theme.py), so a cold start is not black. -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
